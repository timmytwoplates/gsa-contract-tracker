# =============================================================================
# gsa-contract-tracker — Environment Variable Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env  (cp .env.template .env)
#   2. Fill in values below
#   3. NEVER commit .env — it is in .gitignore
#   4. For GitHub Actions, add each variable as a Repository Secret:
#      Settings → Secrets and variables → Actions → New repository secret
# =============================================================================

# ---------------------------------------------------------------------------
# GSA D2D (Data to Decisions) — only required if D2D integration is enabled
# Leave blank if using manual CSV export workflow
# ---------------------------------------------------------------------------
D2D_USERNAME=
D2D_PASSWORD=

# ---------------------------------------------------------------------------
# GitHub Actions bot credentials — used by workflows to commit updated DB
# These are set as GitHub repository secrets, not here.
# Included for documentation purposes only.
# ---------------------------------------------------------------------------
# GH_TOKEN=          # Set in GitHub Secrets, not here
# GH_EMAIL=          # Git commit email for Actions bot

# ---------------------------------------------------------------------------
# Optional: Streamlit app configuration
# ---------------------------------------------------------------------------
# STREAMLIT_SERVER_PORT=8501

# ---------------------------------------------------------------------------
# Notifications (optional — for future alerting on pipeline failures)
# ---------------------------------------------------------------------------
# ALERT_EMAIL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
